# ============================================
# 1. БАЗОВЫЙ ОБРАЗ ДЛЯ СБОРКИ
# ============================================
# Используем официальный образ Go для сборки
FROM golang:1.21-alpine AS builder

# Устанавливаем необходимые пакеты
RUN apk add --no-cache git ca-certificates

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# ============================================
# 2. КОПИРУЕМ ЗАВИСИМОСТИ
# ============================================
# Копируем go.mod и go.sum (это кешируется для ускорения сборки)
COPY go.mod go.sum ./

# Загружаем зависимости
RUN go mod download

# ============================================
# 3. КОПИРУЕМ ИСХОДНЫЙ КОД И СОБИРАЕМ
# ============================================
# Копируем весь исходный код
COPY . .

# Собираем приложение
# CGO_ENABLED=0 - отключаем CGO для статической сборки
# GOOS=linux - собираем для Linux
# -a - пересобираем все пакеты
# -installsuffix cgo - отключаем CGO
# -o weather-parser - имя выходного файла
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o weather-parser .

# ============================================
# 4. ФИНАЛЬНЫЙ ОБРАЗ (МАЛЕНЬКИЙ)
# ============================================
# Используем минимальный образ Alpine
FROM alpine:latest

# Устанавливаем сертификаты и часовые пояса
RUN apk --no-cache add ca-certificates tzdata

# Создаем пользователя (без прав root)
RUN adduser -D -g '' appuser

# Копируем скомпилированный бинарник из этапа сборки
COPY --from=builder /app/weather-parser /usr/local/bin/

# Копируем .env файл (если он есть)
COPY --from=builder /app/.env /app/.env 2>/dev/null || true

# Создаем папку для данных
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Переключаемся на пользователя
USER appuser

# Устанавливаем рабочую директорию
WORKDIR /app

# ============================================
# 5. HEALTHCHECK (ПРОВЕРКА ЖИЗНЕСПОСОБНОСТИ)
# ============================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD ["weather-parser", "-healthcheck"] || exit 1

# ============================================
# 6. ЗАПУСК
# ============================================
CMD ["weather-parser"]